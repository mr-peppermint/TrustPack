# ---------------------------------------------------------------- Upstream services
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_URL=https://pypi.org
GITHUB_API_URL=https://api.github.com
GITHUB_CODELOAD_URL=https://codeload.github.com
# Optional: raises GitHub API rate limits from 60/hr to 5000/hr
GITHUB_TOKEN=

# Allow-listed hosts for outbound downloads (comma-separated). Every request and every redirect hop
# must target one of these, resolve only to public addresses, and uses the default HTTPS port.
ALLOWED_TARBALL_HOSTS=registry.npmjs.org
ALLOWED_PYPI_HOSTS=pypi.org,files.pythonhosted.org
ALLOWED_SOURCE_HOSTS=github.com,codeload.github.com,api.github.com

# ---------------------------------------------------------------- HTTP behaviour
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
MAX_REDIRECTS=5
MAX_METADATA_BYTES=20971520

# ---------------------------------------------------------------- Archive / resource limits
MAX_TARBALL_SIZE_BYTES=52428800
MAX_EXTRACTED_SIZE_BYTES=209715200
MAX_SINGLE_FILE_SIZE_BYTES=20971520
MAX_FILE_COUNT=20000
# Zip entries over 1 MiB that expand more than this many times are rejected as decompression bombs
MAX_COMPRESSION_RATIO=1000

# ---------------------------------------------------------------- Persistent analysis history (SQLite)
# Default: backend/data/trustpack.db
DATABASE_PATH=
# Oldest reports beyond this count are pruned; 0 TTL = never expire by age
REPORT_RETENTION_LIMIT=1000
REPORT_TTL_SECONDS=0

# ---------------------------------------------------------------- Shared analysis cache (Supabase, optional)
# Disabled unless both of these are set. When on, a finished analysis of a package version is shared
# across all users/instances: the next request for the same (ecosystem, name, version, repository) is
# served from here instead of re-downloading and re-scanning. Create the table with supabase/schema.sql.
SUPABASE_URL=
# Server-side secret (the service_role key, not the anon key). Never commit it, never expose it to the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=analysis_cache
SUPABASE_TIMEOUT=5
# Cached reports older than this are ignored; 0 = never expire by age. Default: 7 days.
CACHE_TTL_SECONDS=604800
# Bump this after changing detection rules/scoring so previously cached verdicts stop being served.
CACHE_ENGINE_VERSION=1

# ---------------------------------------------------------------- Concurrency / timeouts
MAX_CONCURRENT_ANALYSES=3
ANALYSIS_TIMEOUT_SECONDS=90
# Per-IP throttle on the analysis-starting endpoints only, once the API is reachable from the internet.
# 0 disables it. Not a security boundary (client IP is best-effort) -- just blunts casual abuse of
# upstream quotas (GitHub, the AI provider, Supabase).
RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------- AI explanations (optional)
# The analysis and its verdict never depend on this. With AI_ENABLED=false (default) nothing is sent anywhere.
AI_ENABLED=false
# groq | openrouter | openai | together | fireworks, or any OpenAI-compatible server via AI_BASE_URL
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
# Server-side secret. Never commit it, never expose it to the frontend.
AI_API_KEY=
# Leave empty to use the provider's default endpoint. https only (http is accepted for localhost).
AI_BASE_URL=
AI_TIMEOUT=60
AI_MAX_FINDINGS=25

# ---------------------------------------------------------------- CORS (origins allowed to call this API from a browser)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO
