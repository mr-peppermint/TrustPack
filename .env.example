# Frontend configuration (Vite). Copy to .env.local (gitignored... check .gitignore before committing
# any real value) and restart `npm run dev`. All VITE_ values are bundled into the browser build, so
# never put secrets here — the backend's own secrets live in backend/.env instead.

# Where the backend (backend/app, FastAPI) is listening. If it runs on a different device on your LAN,
# use that device's LAN IP instead of localhost — see backend/README.md "Running across devices on a LAN".
VITE_API_BASE_URL=http://localhost:8000

# Endpoint paths under VITE_API_BASE_URL. The defaults already match the backend's frontend-contract
# routes (see backend/app/api/routes.py); only override these for a different backend.
# VITE_ENDPOINT_START_ANALYSIS=/analyses
# VITE_ENDPOINT_GET_RESULT=/analyses/{id}
# VITE_ENDPOINT_HISTORY=/analyses
