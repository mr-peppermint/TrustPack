# Upstream services
NPM_REGISTRY_URL=https://registry.npmjs.org
GITHUB_API_URL=https://api.github.com
GITHUB_CODELOAD_URL=https://codeload.github.com
# Optional: raises GitHub API rate limits from 60/hr to 5000/hr (unauthenticated/authenticated)
GITHUB_TOKEN=

# Allow-listed hosts for outbound downloads (comma-separated)
ALLOWED_TARBALL_HOSTS=registry.npmjs.org
ALLOWED_SOURCE_HOSTS=github.com,codeload.github.com,api.github.com

# HTTP behavior
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# Archive / resource limits
MAX_TARBALL_SIZE_BYTES=52428800
MAX_EXTRACTED_SIZE_BYTES=209715200
MAX_SINGLE_FILE_SIZE_BYTES=20971520
MAX_FILE_COUNT=20000

# Report store
REPORT_RETENTION_LIMIT=200

# Concurrency / timeouts
MAX_CONCURRENT_ANALYSES=3
ANALYSIS_TIMEOUT_SECONDS=90

# CORS (comma-separated origins allowed to call this API from a browser)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO
